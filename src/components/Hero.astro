<style>
  #home {
    background: url('https://s17.postimg.org/m4bfqfgn3/fog_1005445_1920.jpg') no-repeat center center fixed;
    background-size: cover;
    text-shadow: 1px 1px 0 rgba(250, 248, 245, 0.5);
    text-align: left;
    padding-top: 260px;
  }

  #home h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: 38px;
