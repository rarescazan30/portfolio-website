---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Rares Cazan`}>
  <Navbar />
  
  <header id="article-header" class="content-section">
    <div class="container">
      <div class="content-col">
        <a href="/blog" class="back-link">← back to blog</a>
        <h1>{entry.data.title}</h1>
        <p class="article-desc">{entry.data.description}</p>
        <div class="article-meta">
          <span class="article-date">
            {entry.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </span>
          {entry.data.tag && <span class="article-tag">{entry.data.tag}</span>}
        </div>
      </div>
    </div>
  </header>

  <article class="content-section article-content">
    <div class="container">
      <div class="content-col prose">
        <Content />
      </div>
    </div>
  </article>

  <Footer />
</Layout>

<style>
  #article-header {
    text-align: left;
    padding-top: 260px;
  }

  .back-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-text-subtle);
    margin-bottom: 20px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  #article-header h1 {
    display: block;
    font-size: 26px;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.7em;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 12px;
    text-decoration-thickness: 1px;
    margin-top: 10px;
    margin-bottom: 12px;
    padding-bottom: 16px;
  }

  /* Remove the global orange underline from Layout.astro */
  #article-header h1:after {
    display: none;
  }

  .article-desc {
    font-size: 18px;
    line-height: 1.6em;
    color: var(--color-text);
    margin-bottom: 22px;
    text-transform: none;
  }

  .article-meta {
    margin-top: 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .article-date {
    font-size: 13px;
    color: var(--color-text-subtle);
    text-transform: lowercase;
  }

  .article-tag {
    font-size: 13px;
    color: var(--color-text-subtle);
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    padding: 2px 7px;
    text-transform: lowercase;
    line-height: 1.2;
    display: inline-block;
  }

  .article-content {
    padding-top: 0;
    min-height: 50vh;
  }

  /* Basic prose styling for the markdown content */
  .prose {
    font-size: 18px;
    line-height: 1.6em;
    color: var(--color-text);
  }
  
  .prose :global(h2) {
    font-size: 24px;
    font-weight: 500;
    color: var(--color-accent);
    margin-top: 45px;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }
  
  .prose :global(h3) {
    font-size: 22px;
    margin-top: 30px;
    margin-bottom: 15px;
    font-weight: 600;
    color: var(--color-text-strong);
  }
  
  .prose :global(p) {
    margin-bottom: 22px;
  }
  
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  
  .prose :global(a:hover) {
    border-bottom: 1px solid var(--color-accent);
  }
  
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: 20px;
    padding-left: 20px;
  }
  
  .prose :global(li) {
    margin-bottom: 10px;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .prose :global(em),
  .prose :global(i) {
    font-size: inherit;
    font-style: italic;
    font-weight: 500;
    color: var(--color-text-strong);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 15px;
    background-color: var(--color-surface-strong);
    color: var(--color-text-body);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .prose :global(pre) {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 16px 20px;
    margin: 24px 0;
    overflow-x: auto;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .prose :global(pre code) {
    background-color: transparent;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: 14.5px;
    line-height: 1.5;
  }

  @media screen and (min-width: 768px) {
    #article-header {
      padding-top: 280px;
    }
  }

  @media screen and (min-width: 992px) {
    #article-header {
      padding-top: 300px;
    }
  }

  @media screen and (min-width: 1200px) {
    #article-header {
      padding-top: 320px;
    }
  }
</style>
