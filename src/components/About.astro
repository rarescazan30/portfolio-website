---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPosts = posts.slice(0, 3);
---

<!-- ABOUT -->
<div id="about" class="content-section">
  <div class="now-sidecar">
    <h4>now:</h4>
    <span class="now-timestamp">updated september 2026</span>
    <p><span class="category-title">building:</span> real-time comp vision analysis & agentic RAG for regulatory auditing.</p>
    <p><span class="category-title">reading:</span> "man and his symbols" — carl jung.</p>
    <p><span class="category-title">researching:</span> epistemic trust in systems; how to engineer AI architectures that can evaluate conflicting truths.</p>

    {latestPosts.length > 0 && (
      <div class="writings-sidecar-block">
        <h4>latest writings:</h4>
        {latestPosts.map((post) => (
          <p>
            <a href={`/blog/${post.id}`} class="writing-link">
              <span class="category-title">{post.data.title.toLowerCase()}</span>
            </a>
          </p>
        ))}
      </div>
    )}
  </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-8 col-lg-7">
        <h1>about me:</h1>
        <p class="lead">
          computer science student at POLITEHNICA University of Bucharest and undergraduate teaching assistant for Assembly and Operating Systems.
        </p>
        <p class="lead">
          i like building software around concrete, messy problems. whether it's training computer-vision tools to teach CPR or configuring flight stacks for a stratospheric UAV, i care about making complex systems work reliably.
        </p>
        <p class="lead">
          outside of engineering, i’m an avid reader of literature and philosophy. i write about the books and ideas that catch my attention over on my blog. you might be surprised how much philosophy you can bring into tech before it gets weird.
        </p>
        <div class="about-block">
          <h4>status:</h4>
          <p>actively seeking a 2027 software engineering internship in Europe.</p>
          <p>currently open to hackathons, open-source contributions, and new collaborations.</p>
        </div>
        
        <div class="about-block">
          <h4>background:</h4>
          <p>pursuing a Bachelor in Computer Science (expected july 2028).</p>
          <p>mentoring student labs on low-level memory concepts (NASM) and Linux system administration (Bash/CLI).</p>
          <p>experience across the stack, from kernel-level asynchronous C servers to pattern-driven Java architectures, embedded systems, agentic AI workflows, and more.</p>
        </div>

        <div class="about-block">
          <h4>core tech stack:</h4>
          <p><span class="category-title">languages:</span> C, Java, Python, C++, TypeScript, SQL, Assembly (NASM), Haskell.</p>
          <p><span class="category-title">web &amp; backend:</span> Node.js, React, WebSockets, PostgreSQL, Docker, REST APIs.</p>
          <p><span class="category-title">ai &amp; computer vision:</span> Agentic RAG, Vector Databases (ChromaDB), MediaPipe.</p>
        </div>

        <div class="about-block">
          <h4>current focus:</h4>
          <p><span class="project-tag">goMed:</span> architecting the real-time WebSocket backend (Supabase/PostgreSQL) and client-side MediaPipe/WebAssembly pose-tracking engine for a gamified CPR training application.</p>
          <p><span class="project-tag">RegAdjudicator:</span> engineering a Python agentic RAG system with a ReAct orchestration loop and self-verifying citation pipeline to audit FDA/EMA regulatory divergence.</p>
          <p><span class="project-tag">ROSPIN (NOTUS Project):</span> developing the autonomy stack for a stratospheric UAV, focusing on On-Board Computer (OBC) hardware selection, ArduPilot integration, and writing system automation scripts.</p>
          <p><span class="project-tag">Faculty Students' League (IT Dept):</span> maintaining internal services, integrating third-party APIs for 500+ active users, and standardizing backend REST documentation with Swagger/OpenAPI.</p>
        </div>
      </div>

      <div class="col-sm-4 col-lg-5 hidden-xs">
      </div>
    </div>
  </div>
</div>

<style>
  #about {
    position: relative;
  }

  .now-sidecar {
    font-family: 'Montserrat', sans-serif;
    position: absolute;
    top: 350px;
    right: 55px;
    width: 350px;
    z-index: 10;
  }

  .now-sidecar h4 {
    font-size: 20px;
    font-weight: 500;
    color: #C46353;
    text-transform: lowercase;
    margin-top: 0;
    margin-bottom: 6px;
    display: inline-block;
    transition: transform 0.25s ease;
    cursor: default;
  }

  .now-sidecar h4:hover {
    transform: translateY(-2px);
  }

  .now-sidecar h4:after {
    content: '';
    display: block;
    border-bottom: 1px solid #DFDFDF;
    padding-top: 3px;
  }

  .now-timestamp {
    font-size: 11.5px;
    color: #888;
    text-transform: lowercase;
    display: block;
    margin-top: 6px;
    margin-bottom: 12px;
  }

  .now-sidecar p {
    font-size: 14.5px;
    line-height: 1.65em;
    color: #444;
    margin-bottom: 10px;
  }

  .now-sidecar .category-title {
    color: #C46353;
    font-weight: 500;
    display: inline;
  }

  .writings-sidecar-block {
    margin-top: 100px;
  }

  .writings-sidecar-block p:first-of-type {
    margin-top: 10px;
  }

  .writing-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .writing-link:hover {
    transform: translateX(3px);
  }

  .writing-link .category-title {
    color: #333;
    transition: color 0.2s ease;
  }

  .writing-link:hover .category-title {
    color: #C46353;
  }

  @media screen and (max-width: 1199px) {
    .now-sidecar {
      right: 20px;
      width: 250px;
    }
  }

  @media screen and (max-width: 991px) {
    .now-sidecar {
      position: static;
      width: 100%;
      padding: 0 15px;
      margin-top: 30px;
    }
  }

  #about h1 {
    font-size: 26px;
    font-weight: 500;
    color: #C46353;
    margin-top: 10px;
    margin-bottom: 12px;
    transition: transform 0.25s ease;
    cursor: default;
  }

  #about h1:hover {
    transform: translateY(-2.5px);
  }

  #about p.lead {
    font-size: 18px;
    line-height: 1.6em;
    color: #333;
    margin-bottom: 22px;
  }

  .about-block {
    margin-top: 22px;
  }

  .about-block h4 {
    font-size: 14px;
    font-weight: 600;
    color: #C46353;
    text-transform: lowercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    display: inline-block;
    transition: transform 0.25s ease;
    cursor: default;
  }

  .about-block h4:hover {
    transform: translateY(-2px);
  }

  .about-block p {
    font-size: 14.5px;
    line-height: 1.65em;
    color: #444;
    margin-bottom: 8px;
  }

  .category-title {
    color: #111;
    font-weight: 500;
    display: inline;
  }

  .project-tag {
    color: #111;
    font-weight: 500;
    display: inline;
  }
</style>
