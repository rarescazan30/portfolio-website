---
import resumeIcon from '../assets/resume.svg';
import linkedinIcon from '../assets/linkedin.svg';
import githubIcon from '../assets/github.svg';
import resumePdf from '../assets/september-resume.pdf';
---

<!-- CONTACT -->
<section id="contact" class="content-section">
  <div class="container">
    <h1>contact me.</h1>
    <p class="lead">always open to collaborate!</p>

    <div class="social-cont">
      <a class="contact-btn resume-btn" href={resumePdf} target="_blank">
        <div class="icon-square">
          <img src={resumeIcon.src} alt="" class="icon-img" />
        </div>
        <span class="btn-text">resume</span>
      </a>

      <a class="contact-btn github-btn" href="https://github.com/rarescazan30" target="_blank">
        <div class="icon-square">
          <img src={githubIcon.src} alt="" class="icon-img" />
        </div>
        <span class="btn-text">github</span>
      </a>

      <a class="contact-btn linkedin-btn" href="https://www.linkedin.com/in/rares-cazan-121b8b389/" target="_blank">
        <div class="icon-square">
          <img src={linkedinIcon.src} alt="" class="icon-img" />
        </div>
        <span class="btn-text">linkedin</span>
      </a>
    </div>

    <!-- SEND ME A MESSAGE FORM -->
    <div class="message-form-container">
      <h4 class="form-heading">send me a message:</h4>

      <form id="contact-form" class="minimal-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="23e658ec-cdc0-418b-a366-d482250a695d" />
        <input type="hidden" name="subject" value="New Message from Portfolio Website" />

        <div class="form-group">
          <label for="name" class="sr-only">name</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="alex" required />
        </div>

        <div class="form-group">
          <label for="email" class="sr-only">email</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="alex@example.com" required />
        </div>

        <div class="form-group">
          <label for="message" class="sr-only">message</label>
          <textarea
            id="message"
            name="message"
            class="form-textarea"
            rows="4"
            placeholder="hey rares, wanted to connect about..."
            required
          ></textarea>
        </div>

        <button type="submit" id="submit-btn" class="send-btn">send message</button>

        <div id="form-status" class="form-status" role="status"></div>
      </form>
    </div>
  </div>
</section>

<script>
  // `astro:page-load` (not DOMContentLoaded) so this also runs after
  // client-side navigation, e.g. coming back to home from the blog.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const status = document.getElementById('form-status')!;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    const showStatus = (text: string, kind: 'success' | 'error') => {
      status.textContent = text;
      status.className = `form-status ${kind}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = 'sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          showStatus('message sent successfully! i will get back to you soon.', 'success');
          form.reset();
        } else {
          showStatus(data.message || 'something went wrong. please try again.', 'error');
        }
      } catch {
        showStatus('network error. please try again or email directly.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'send message';
      }
    });
  });
</script>

<style>
  #contact h1 {
    font-size: 26px;
    font-weight: 500;
    color: var(--color-accent);
    margin-top: 10px;
    margin-bottom: 12px;
  }

  #contact p.lead {
    font-size: 18px;
    line-height: 1.6em;
    color: var(--color-text);
    margin-bottom: 24px;
  }

  .social-cont {
    max-width: 460px;
    margin-bottom: 28px;
  }

  .contact-btn {
    display: flex;
    align-items: center;
    height: 45px;
    width: 140px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    margin: 0 10px 14px 0;
    position: relative;
    overflow: hidden;
    text-decoration: none !important;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .icon-square {
    width: 48px;
    height: 48px;
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-sizing: border-box;
  }

  .icon-img {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    display: block;
  }

  .btn-text {
    position: relative;
    z-index: 2;
    margin-left: 60px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-text-strong);
    text-transform: lowercase;
    transition: color 0.3s ease;
  }

  /* Sliding Background Accent Block */
  .contact-btn:after {
    content: '';
    display: block;
    width: 48px;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    transition: width 0.35s ease;
  }

  .resume-btn:after {
    background-color: var(--color-accent);
  }

  .linkedin-btn:after {
    background-color: var(--color-linkedin);
  }

  .github-btn:after {
    background-color: var(--color-github);
  }

  /* Hover States */
  .contact-btn:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-soft);
    transform: translateY(-1px);
  }

  .contact-btn:hover .btn-text {
    color: var(--color-on-accent);
  }

  .contact-btn:hover:after {
    width: 100%;
  }

  /*--- MESSAGE FORM STYLES ---*/
  .message-form-container {
    max-width: 480px;
    margin-top: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .form-heading {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
    text-transform: lowercase;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
    display: inline-block;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    padding-bottom: 2px;
  }

  .minimal-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 0;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 10px 14px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    font-size: 14px;
    color: var(--color-text-strong);
    outline: none;
    transition: all 0.2s ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--color-text-subtle);
    font-size: 13.5px;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .send-btn {
    align-self: flex-start;
    padding: 8px 22px;
    background-color: var(--color-bg);
    border: 1.5px solid var(--color-accent);
    border-radius: 4px;
    color: var(--color-accent);
    font-size: 13.5px;
    font-weight: 600;
    text-transform: lowercase;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 4px;
  }

  .send-btn:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .form-status {
    font-size: 13.5px;
    margin-top: 6px;
    line-height: 1.4em;
  }

  .form-status.success {
    color: var(--color-success);
  }

  .form-status.error {
    color: var(--color-error);
  }
</style>
