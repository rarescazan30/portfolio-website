    text-transform: lowercase;
    margin-top: 10px;
  }

  @media screen and (min-width: 768px) {
    #home {
      padding-top: 280px;
    }

    #home h1 {
      font-size: 48px;
    }

    #home h5 {
      font-size: 14px;
    }
  }

  @media screen and (min-width: 992px) {
    #home {
      padding-top: 300px;
    }

    #home h1 {
      font-size: 54px;
    }

    #home h5 {
      font-size: 15px;
    }
  }

  @media screen and (min-width: 1200px) {
    #home {
