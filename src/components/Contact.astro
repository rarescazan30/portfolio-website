---
import resumeIcon from '../assets/resume.svg';
import linkedinIcon from '../assets/linkedin.svg';
import githubIcon from '../assets/github.svg';
import resumePdf from '../assets/september-resume.pdf';
---

<!-- CONTACT -->
<div id="contact" class="content-section">
  <div class="container">
    <div class="row">
      <div class="col-sm-12">
        <h1>contact me.</h1>
        <p class="lead">always open to collaborate!</p>
        
        <div class="social-cont">
          <div class="row">
            <div class="col-sm-12">
              <a class="contact-btn resume-btn" href={resumePdf} target="_blank">
                <div class="icon-square">
                  <img src={resumeIcon.src} alt="Resume" class="icon-img" />
                </div>
                <span class="btn-text">resume</span>
              </a>

              <a
                class="contact-btn github-btn"
                href="https://github.com/rarescazan30"
                role="button"
                target="_blank"
              >
                <div class="icon-square">
                  <img src={githubIcon.src} alt="GitHub" class="icon-img" />
                </div>
                <span class="btn-text">github</span>
              </a>

              <a
                class="contact-btn linkedin-btn"
                href="https://www.linkedin.com/in/rares-cazan-121b8b389/"
                role="button"
                target="_blank"
              >
                <div class="icon-square">
                  <img src={linkedinIcon.src} alt="LinkedIn" class="icon-img" />
                </div>
                <span class="btn-text">linkedin</span>
              </a>
            </div>
          </div>
        </div>

        <!-- SEND ME A MESSAGE FORM -->
        <div class="message-form-container">
          <h4 class="form-heading">send me a message:</h4>
          
          <form id="contact-form" class="minimal-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="23e658ec-cdc0-418b-a366-d482250a695d" />
            <input type="hidden" name="subject" value="New Message from Portfolio Website" />

            <div class="form-group">
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                placeholder="alex"
                required
              />
            </div>

            <div class="form-group">
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="alex@example.com"
                required
              />
            </div>

            <div class="form-group">
              <textarea
                id="message"
                name="message"
                class="form-textarea"
                rows="4"
                placeholder="hey rares, wanted to connect about..."
                required
              ></textarea>
            </div>

            <button type="submit" id="submit-btn" class="send-btn">
              <span>send message</span>
            </button>

            <div id="form-status" class="form-status"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    const status = document.getElementById("form-status");
    const submitBtn = document.getElementById("submit-btn");

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const accessKey = formData.get("access_key");

        // If no API key configured yet, provide clean mailto fallback
        if (accessKey === "YOUR_ACCESS_KEY_HERE") {
          const name = formData.get("name");
          const email = formData.get("email");
          const message = formData.get("message");
          const mailtoUrl = `mailto:rarescazan@gmail.com?subject=Message from ${encodeURIComponent(name)}&body=${encodeURIComponent(message + "\n\nFrom: " + name + " (" + email + ")")}`;
          window.location.href = mailtoUrl;
          status.textContent = "opening your email app...";
          status.className = "form-status success";
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "sending...";

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            body: formData,
          });

          const data = await response.json();
          if (data.success) {
            status.textContent = "message sent successfully! i will get back to you soon.";
            status.className = "form-status success";
            form.reset();
          } else {
            status.textContent = data.message || "something went wrong. please try again.";
            status.className = "form-status error";
          }
        } catch (error) {
          status.textContent = "network error. please try again or email directly.";
          status.className = "form-status error";
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "send message";
        }
      });
    }
  });
</script>

<style>
  #contact h1 {
    font-size: 26px;
    font-weight: 500;
    color: #C46353;
    margin-top: 10px;
    margin-bottom: 12px;
  }

  #contact p.lead {
    font-size: 18px;
    line-height: 1.6em;
    color: #333;
    margin-bottom: 24px;
  }

  .social-cont {
    max-width: 460px;
    margin-bottom: 28px;
  }

  .contact-btn {
    display: flex;
    align-items: center;
    height: 45px;
    width: 140px;
    background-color: #FAF8F5;
    border: 1px solid #D8D4CC;
    border-radius: 4px;
    margin: 0 10px 14px 0;
    position: relative;
    overflow: hidden;
    text-decoration: none !important;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .icon-square {
    width: 48px;
    height: 48px;
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-sizing: border-box;
  }

  .icon-img {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    display: block;
  }

  .btn-text {
    position: relative;
    z-index: 2;
    margin-left: 60px;
    font-size: 14.5px;
    font-weight: 500;
    color: #222;
    text-transform: lowercase;
    transition: color 0.3s ease;
  }

  /* Sliding Background Accent Block */
  .contact-btn:after {
    content: '';
    display: block;
    width: 48px;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    transition: width 0.35s ease;
  }

  .resume-btn:after {
    background-color: #C46353;
  }

  .linkedin-btn:after {
    background-color: #0077B5;
  }

  .github-btn:after {
    background-color: #24292E;
  }

  /* Hover States */
  .contact-btn:hover {
    border-color: #BAAF9F;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
  }

  .contact-btn:hover .btn-text {
    color: #FAF8F5;
  }

  .contact-btn:hover:after {
    width: 100%;
  }

  /*--- MESSAGE FORM STYLES ---*/
  .message-form-container {
    max-width: 480px;
    margin-top: 10px;
    padding-top: 24px;
    border-top: 1px solid #EAE6DF;
  }

  .form-heading {
    font-size: 15px;
    font-weight: 600;
    color: #C46353;
    text-transform: lowercase;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
    display: inline-block;
    border-bottom: 1px solid rgba(196, 99, 83, 0.35);
    padding-bottom: 2px;
  }

  .minimal-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 0;
  }

  .form-label {
    font-size: 13.5px;
    font-weight: 500;
    color: #555;
    text-transform: lowercase;
    margin: 0;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 10px 14px;
    background-color: #FAF8F5;
    border: 1px solid #D8D4CC;
    border-radius: 4px;
    font-size: 14px;
    color: #222;
    font-family: 'Montserrat', sans-serif;
    outline: none;
    transition: all 0.2s ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: #999;
    font-size: 13.5px;
  }

  .form-input:focus,
  .form-textarea:focus {
    border-color: #C46353;
    box-shadow: 0 0 0 3px rgba(196, 99, 83, 0.12);
  }

  .form-textarea {
    resize: vertical;
    min-height: 90px;
  }

  .send-btn {
    align-self: flex-start;
    padding: 8px 22px;
    background-color: #FAF8F5;
    border: 1.5px solid #C46353;
    border-radius: 4px;
    color: #C46353;
    font-size: 13.5px;
    font-weight: 600;
    text-transform: lowercase;
    font-family: 'Montserrat', sans-serif;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 4px;
  }

  .send-btn:hover {
    background-color: #C46353;
    color: #FAF8F5;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(196, 99, 83, 0.2);
  }

  .form-status {
    font-size: 13.5px;
    margin-top: 6px;
    line-height: 1.4em;
  }

  .form-status.success {
    color: #5B8266;
  }

  .form-status.error {
    color: #EF4444;
  }
</style>
