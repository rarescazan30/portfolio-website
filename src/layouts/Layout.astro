---
interface Props {
  title?: string;
}

import { ClientRouter } from 'astro:transitions';
const { title = "Rares Cazan" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />

    <!-- Google Font: Montserrat (All Weights) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css" />

    <!-- Bootstrap 3 CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css" />
  </head>
  <body>
    <slot />

    <!-- Scripts for smooth scrolling -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.3/jquery.min.js"></script>
    <script is:inline src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/js/bootstrap.min.js"></script>
    <script is:inline>
      document.addEventListener('astro:page-load', function () {
        // Smooth scroll on click
        $(".scroll").click(function (event) {
          if (this.hash !== "") {
            var hash = this.hash;
            var target = $(hash);
            // Only intercept if the target exists on the current page
            if (target.length) {
              event.preventDefault();
              $("html, body").animate({ scrollTop: target.offset().top }, 500, function () {
                window.location.hash = hash;
              });
              $(".navbar-default a").removeClass("selected");
              $(this).addClass("selected");
            }
          }
        });

        // Scrollspy: update active link as page is scrolled
        const sections = document.querySelectorAll("div.content-section[id]");
        const navLinks = document.querySelectorAll(".navbar-nav a.scroll");

        function updateScrollSpy() {
          const scrollPos = window.scrollY + 200; // navbar offset threshold

          sections.forEach((section) => {
            const top = section.offsetTop;
            const height = section.offsetHeight;
            const id = section.getAttribute("id");

            if (scrollPos >= top && scrollPos < top + height) {
              navLinks.forEach((link) => {
                link.classList.remove("selected");
                if (link.getAttribute("href").endsWith(`#${id}`)) {
                  link.classList.add("selected");
                }
              });
            }
          });
        }

        window.addEventListener("scroll", updateScrollSpy, { passive: true });
        updateScrollSpy();
      });
    </script>
    <script>
      import { navigate } from 'astro:transitions/client';
      
      document.addEventListener('astro:page-load', () => {
        // Find all cross-page links (blog link, and home links)
        const crossPageLinks = document.querySelectorAll('a[href="/blog"], a.scroll, a.navbar-brand');
        
        crossPageLinks.forEach(link => {
          link.addEventListener('click', (e) => {
            const targetHref = link.getAttribute('href');
            
            // Check if this link navigates away from the current page/layout specifically between Home and Blog
            const isToBlog = targetHref === '/blog';
            const isToExactHome = targetHref === '/#home' || targetHref === '/';
            const isOnHome = window.location.pathname === '/';
            
            // We want to intercept if we are navigating strictly between Home and Blog and are scrolled down
            const shouldIntercept = (isToBlog && isOnHome) || (isToExactHome && !isOnHome);

            if (shouldIntercept && window.scrollY > 0) {
              e.preventDefault();
              const scrollDuration = Math.max(400, Math.min(window.scrollY * 0.3, 800));
              
              window.$("html, body").animate({ scrollTop: 0 }, scrollDuration);
              setTimeout(() => {
                navigate(targetHref);
              }, scrollDuration + 300);
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /*--- UNIVERSAL MONTSERRAT FONT APPLIED EVERYWHERE ---*/
  *,
  *::before,
  *::after {
    font-family: 'Montserrat', sans-serif;
  }

  html {
    scroll-behavior: smooth;
    font-family: 'Montserrat', sans-serif;
  }

  body {
    font-size: 16px;
    line-height: 1.6em;
    font-family: 'Montserrat', sans-serif;
    color: #333;
    background-color: #FAF8F5;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    color: #1a1a1a;
  }

  .content-section {
    min-height: 100vh;
    padding-top: 70px;
    padding-bottom: 20px;
  }

  .content-section h1 {
    font-family: 'Montserrat', sans-serif;
    color: #9C9C9C;
    font-weight: 400;
    font-size: 30px;
    display: inline-block;
    margin-top: 20px;
    margin-bottom: 10px;
  }

  .content-section h1:after {
    content: '';
    display: block;
    border-bottom: 1px solid #DFDFDF;
    padding-top: 3px;
  }

  .content-section p.lead {
    font-family: 'Montserrat', sans-serif;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.5em;
    margin-bottom: 25px;
    color: #333;
  }

  .content-section p em {
    font-size: 14px;
  }

  .content-section p mark em {
    font-size: inherit;
  }

  .content-section img.pull-right {
    border: 1px solid #DFDFDF;
    margin-top: 140px;
  }

  @media screen and (min-width: 768px) {
    .content-section {
      padding-top: 130px;
    }

    .content-section h1 {
      font-size: 34px;
    }

    .content-section p.lead {
      margin-bottom: 30px;
    }
  }

  @media screen and (min-width: 992px) {
    .content-section {
      padding-top: 160px;
    }

    .content-section h1 {
      font-size: 38px;
    }

    .content-section h1:after {
      padding-top: 5px;
    }

    .content-section p.lead {
      font-size: 21px;
      margin-bottom: 35px;
    }
  }

  @media screen and (min-width: 1200px) {
    .content-section {
      padding-top: 160px;
    }

    .content-section h1:after {
      padding-top: 7px;
    }

    .content-section p.lead {
      font-size: 22px;
      margin-bottom: 35px;
    }
  }
</style>
