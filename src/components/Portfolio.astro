---
import regAdjudicatorImg from '../assets/regAdjudicator-image.jpg';
import goMedImg from '../assets/goMed-image.jpg';
import asyncServerImg from '../assets/async-web-server.jpg';
import titles101Img from '../assets/101-titles.jpg';
import githubIcon from '../assets/github-icon.svg';

const projects = [
  {
    id: 1,
    title: "regAdjudicator",
    description: "Reference implementation of an agentic RAG system that detects and explains conflicts between US (FDA) and EU (EMA) drug regulations, considering trial design requirements, approval pathways, patient population restrictions, and grounds every claim in a citation back to the source document.",
    image: regAdjudicatorImg.src,
    motivation: "I built RegAdjudicator as a sandbox to explore the realities of agentic AI. I wanted to move beyond basic RAG tutorials to see how multi-step reasoning, dynamic tool interactions, and self-correction actually function. I chose to aim this architecture at FDA and EMA regulatory divergence because it's a high-stakes problem that compliance teams wrestle with daily. It was the perfect opportunity to learn how agents handle conflicting truths while building an architecture that points toward a tangible, real-world solution.",
    github: "https://github.com/rarescazan30/regAdjudicator",
    demo: "",
  },
  {
    id: 2,
    title: "goMed",
    description: "Modern educational tool for schools. goMed gamifies first-aid and CPR training through a web-based application. The platform utilizes Google’s MediaPipe Pose detection to analyze and correct a user's CPR compression posture and depth in real-time, running entirely on the client’s device to eliminate network latency. Integrated WebXR and AR interactive models help players vizualize moves, alongside real-time multiplayer lobbies where educators can host classroom quiz challenges to test knowledge acquisition.",
    image: goMedImg.src,
    motivation: "Developed as part of a funded initiative to teach first aid in schools. goMed aims to teach impactful medical training. Our motivation was to combine the technical challenge of client-side computer vision with a genuine solution for student disengagement. Instead of a standard passive app, we built an architecture that forces active practice, analyzing a student's actual CPR cadence in real-time through the web browser. We managed to deliver a platform that is currently being used in schools across the country and provides students and teachers with an engaging and effective way to learn and practice first aid.",
    github: "https://github.com/asemedu/goMed",
    demo: "",
  },
  {
    id: 3,
    title: "Async Web Server",
    description: "High-performance, single-threaded HTTP server written in C, built around an event-driven architecture instead of the traditional thread-per-connection model. The server uses Linux's epoll API for I/O multiplexing, handling many concurrent client connections on a single thread without blocking. Connection lifecycles are managed through an internal state machine that transitions cleanly between receiving data, parsing HTTP headers, reading files, and transmitting responses. Static file transfers use sendfile for zero-copy delivery straight from disk to socket buffer, minimizing CPU context switches. Request parsing is handled through a dedicated HTTP parser, keeping the server robust against malformed or adversarial input.",
    image: asyncServerImg.src,
    motivation: "This started as a systems programming assignment, but the brief only asked for a working non-blocking server, it didn't require zero-copy transfer or a formal state machine for connection handling. I added both because I wanted to understand why real servers (like nginx) are built this way, not just make something that passed the tests. Working through epoll's edge cases and getting sendfile to behave correctly across different connection states forced me to actually reason about kernel-level I/O instead of treating sockets as a black box. It turned an assignment about basic networking into a real lesson in how production infrastructure gets fast.",
    github: "https://github.com/rarescazan30/Async-Web-Server",
    demo: "",
  },
  {
    id: 4,
    title: "101 Titles That Made us Humans",
    description: "Interactive digital gallery showcasing '101 Titles That Made Us Humans', a curated collection of foundational literature. Designed with a minimal aesthetic, users can browse the entire catalog through a grid-based interface. An integrated search dialog makes finding specific authors or titles instantaneous.",
    image: titles101Img.src,
    motivation: "The inspiration for this project was a deeply personal presentation I had the privilege to attend. We were given a list, '101 Titles That Made Us Humans', personally presented by the Romanian philosopher Gabriel Liiceanu. The literary circle I am a part of, 'Cenaclul Pagini și Cerneală', was invited to meet Gabriel Liiceanu in Eugen Lovinescu's Memorial House. A discourse of over 3 hours followed, during which I came in contact with various philosophical and literary ideas which deeply resonated with me. Having had the chance to personally meet such a cultural figure and hear him talk about the books that shaped humanity was an inspiring experience, one that made me want to share the collection with others, in a modern, accessible way.",
    github: "https://github.com/rarescazan30/humanitas-101-titles-that-made-us-humans",
    demo: "https://humanitas-101-titles-that-made-us-h-six.vercel.app",
  },
];

function truncateWords(text: string, maxWords: number = 20): string {
  const words = text.trim().split(/\s+/);
  if (words.length <= maxWords) return text;
  return words.slice(0, maxWords).join(" ") + "...";
}
---

<!-- PORTFOLIO -->
<section id="portfolio" class="content-section">
  <div class="container">
    <div class="content-col">
      <h1>portfolio:</h1>
      <p class="lead">some of my recent work.</p>

      <div class="project-grid">
        {projects.map((project) => (
          <div
            class="project-card"
            role="button"
            tabindex="0"
            aria-expanded="false"
            aria-controls="project-details-panel"
            data-id={project.id}
            data-title={project.title}
            data-description={project.description}
            data-motivation={project.motivation}
            data-github={project.github}
            data-demo={project.demo}
          >
            <img src={project.image} alt="" />
            <div class="caption">
              <h4>{project.title}</h4>
              <p>{truncateWords(project.description, 20)}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- INLINE PROJECT DETAILS PANEL (APPEARS BELOW PROJECTS) -->
      <div id="project-details-panel" class="project-details-panel" hidden>
        <div class="panel-header">
          <h3 id="detail-title" class="detail-title"></h3>
          <button type="button" id="detail-close-btn" class="detail-close-btn" aria-label="Close details">&times;</button>
        </div>

        <div class="panel-body">
          <div class="detail-block">
            <span class="detail-label">description:</span>
            <p id="detail-description" class="detail-text"></p>
          </div>

          <div class="detail-block">
            <span class="detail-label">motivation:</span>
            <p id="detail-motivation" class="detail-text"></p>
          </div>

          <div class="detail-links">
            <a id="detail-demo-link" href="#" target="_blank" class="detail-btn demo-btn">
              <span class="live-dot"></span>
              <span>live demo</span>
            </a>
            <a id="detail-github-link" href="#" target="_blank" class="detail-btn github-btn">
              <img src={githubIcon.src} alt="" width="13" height="13" class="btn-github-img" />
              <span>github / docs</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPortfolio() {
    const panel = document.getElementById('project-details-panel');
    if (!panel) return; // only on the homepage, where the portfolio exists

    const closeBtn = document.getElementById('detail-close-btn')!;
    const titleEl = document.getElementById('detail-title')!;
    const descEl = document.getElementById('detail-description')!;
    const motivationEl = document.getElementById('detail-motivation')!;
    const demoLink = document.getElementById('detail-demo-link') as HTMLAnchorElement;
    const githubLink = document.getElementById('detail-github-link') as HTMLAnchorElement;
    const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];

    let currentSelectedId: string | null = null;

    function setLink(link: HTMLAnchorElement, href: string) {
      link.hidden = !href;
      if (href) link.href = href;
    }

    function showProjectDetails(card: HTMLElement) {
      const { id = null, title = '', description = '', motivation = '', github = '', demo = '' } = card.dataset;

      // Clicking the card that is already open toggles it closed
      if (currentSelectedId === id && !panel!.hidden) {
        closeDetails();
        return;
      }

      currentSelectedId = id;
      cards.forEach((c) => {
        c.classList.toggle('active-card', c === card);
        c.setAttribute('aria-expanded', String(c === card));
      });

      titleEl.textContent = title;
      descEl.textContent = description;
      motivationEl.textContent = motivation;
      setLink(demoLink, demo);
      setLink(githubLink, github);

      panel!.hidden = false;
      // `scroll-margin-top` on the panel keeps it clear of the fixed navbar
      panel!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function closeDetails() {
      panel!.hidden = true;
      currentSelectedId = null;
      cards.forEach((c) => {
        c.classList.remove('active-card');
        c.setAttribute('aria-expanded', 'false');
      });
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => showProjectDetails(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          showProjectDetails(card);
        }
      });
    });

    closeBtn.addEventListener('click', closeDetails);
  }

  document.addEventListener('astro:page-load', initPortfolio);
</script>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px 30px;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    position: relative;
    padding: 4px;
    border-radius: var(--radius);
    line-height: 1.43;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: all 0.25s ease;
    min-height: 320px;
    display: flex;
    flex-direction: column;
  }

  .project-card img {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
  }

  .project-card .caption {
    padding: 12px 14px;
    flex-grow: 1;
  }

  .project-card.active-card {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-accent);
  }

  .project-card * {
    transition: all 0.25s;
  }

  .project-card h4 {
    font-size: 17px;
    font-weight: 600;
    margin-top: 4px;
    margin-bottom: 6px;
    color: var(--color-text-strong);
  }

  .project-card p {
    font-size: 13.5px;
    line-height: 19px;
    color: var(--color-text-muted);
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-card:hover h4,
  .project-card:hover p {
    color: var(--color-text-subtle);
  }

  .project-card:hover img {
    opacity: 0.75;
  }

  .project-card::after {
    content: '↓';
    color: var(--color-accent);
    font-size: 24px;
    font-weight: 500;
    line-height: 44px;
    bottom: 12px;
    position: absolute;
    text-align: center;
    display: inline-block;
    width: 48px;
    height: 48px;
    margin-left: auto;
    margin-right: auto;
    left: 0;
    right: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    border: 2px solid var(--color-accent);
    box-shadow: 0 4px 15px color-mix(in srgb, var(--color-accent) 20%, transparent);
    transition: all 0.3s ease;
    opacity: 0;
    z-index: 5;
  }

  .project-card:hover::after,
  .project-card:focus-visible::after {
    bottom: 24px;
    opacity: 1;
  }

  /*--- INLINE DETAILS PANEL ---*/
  .project-details-panel {
    scroll-margin-top: 150px;
    margin-top: 35px;
    padding: 32px 36px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    animation: panelFadeIn 0.3s ease-out;
  }

  @keyframes panelFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 12px;
    margin-bottom: 20px;
  }

  .detail-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-text-strong);
    margin: 0;
  }

  .detail-close-btn {
    background: transparent;
    border: none;
    font-size: 26px;
    line-height: 1;
    color: var(--color-text-subtle);
    cursor: pointer;
    padding: 2px 8px;
    transition: color 0.2s ease;
  }

  .detail-close-btn:hover {
    color: var(--color-text-strong);
  }

  .detail-block {
    margin-bottom: 16px;
  }

  #portfolio h1 {
    color: var(--color-accent);
  }

  .detail-label {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.5px;
    display: inline-block;
    margin-bottom: 4px;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    padding-bottom: 1px;
  }

  .detail-text {
    font-size: 15px;
    line-height: 1.65em;
    color: var(--color-text-body);
    margin: 4px 0 0 0;
  }

  .detail-links {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .detail-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background-color: var(--color-bg); /* Matches site background */
    border: 1px solid var(--color-accent); /* Muted orange accent border */
    border-radius: 4px;
    color: var(--color-text-strong);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 500;
    text-transform: lowercase;
    line-height: 1.2;
    transition: all 0.2s ease;
  }

  .detail-btn:hover {
    background-color: var(--color-bg);
    color: var(--color-accent);
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: 0 3px 8px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .detail-btn[hidden] {
    display: none;
  }

  .live-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--color-live);
    flex-shrink: 0;
  }

  .btn-github-img {
    width: 13px;
    height: 13px;
    object-fit: contain;
    flex-shrink: 0;
    mix-blend-mode: multiply;
  }
</style>
